# EMSHOP 开发环境配置
#
# 复制为项目根目录的 .env 后生效；生产环境不需要这个文件。
# 优先级：系统真实环境变量 > .env > config.php 默认值。
# 只写需要覆盖的项即可，没写的沿用 config.php 里的默认值。
# 目前支持覆盖「应用配置」和「数据库连接」；后台认证 / 默认图片是固定值，不走 .env。
#
# .env 含数据库密码，已在 .gitignore 中忽略，不要提交。
# Nginx 用户请自行屏蔽直连（Apache / IIS 规则已随项目提供）：
#   location ~ /\.env { deny all; }

# 应用
EM_APP_NAME=EMSHOP
EM_APP_ADMIN_ENTRY=admin

# 数据库
EM_DB_HOST=127.0.0.1
EM_DB_PORT=3306
EM_DB_NAME=emshop
EM_DB_USER=emshop
EM_DB_PASSWORD=
EM_DB_CHARSET=utf8mb4
EM_DB_PREFIX=em_

