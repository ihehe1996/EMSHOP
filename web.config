<?xml version="1.0" encoding="UTF-8"?>
<!--
  EMSHOP 伪静态规则（IIS 用；Nginx 与 Apache 不读本文件）

  @emshop-managed
  上面这行标识用于升级程序判断文件归属：带它才会被升级覆盖
-->
<configuration>
  <system.webServer>
    <!-- 禁止直接访问 .env（开发配置，含数据库密码） -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- 静态资源 MIME：IIS 默认不认识 .webp，未注册时 GET 会被 StaticFileModule
         直接返回 404.3（表现为上传成功、图片却打不开）。先 remove 再 add，
         避免主机已在 applicationHost.config 里注册过同一扩展名时报 500.19。 -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="EMSHOP Rewrite" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <!-- 命中真实存在的文件或目录时不重写，静态资源不受影响 -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- appendQueryString 必须为 true，否则 ?c=goods&amp;a=list 这类参数会被丢掉 -->
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
