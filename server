<?php

declare(strict_types=1); 

// 1. 检查是否安装swoole扩展
if (!extension_loaded('swoole')) {
    echo "无法启动，PHP cli版本：" . PHP_VERSION . " 版本缺少 Swoole 扩展！\n";
    exit(1);
}

define('EM_ROOT', __DIR__);

$command = $argv[1] ?? 'start';

define('SW_DEFAULT_HOST', '0.0.0.0');
define('SW_DEFAULT_PORT', 9600);

define('SW_RUNTIME_DIR', EM_ROOT . '/content/swoole');
define('SW_PID_FILE', SW_RUNTIME_DIR . '/swoole.pid');
define('SW_LOG_FILE', SW_RUNTIME_DIR . '/swoole.log');
define('SW_HEARTBEAT_FILE', SW_RUNTIME_DIR . '/swoole.heartbeat');
define('SW_START_LOCK_FILE', SW_RUNTIME_DIR . '/swoole.start.lock');
define('SW_GOODS_SYNC_BATCH_SIZE', 30);
define('SW_GOODS_SYNC_STATE_KEY', 'swoole_goods_rr_state');
 
// 确保存在swoole的运行目录
if (!is_dir(SW_RUNTIME_DIR)) {
    @mkdir(SW_RUNTIME_DIR, 0755, true);
}

// 启动锁文件
$__swStartLockFp = null;

// 2. 启动前准备（锁、pid检查、MySQL探测、命令分支）
$listen = prepareStartEnvironment($command, $argv ?? [], $__swStartLockFp);

define('SW_HOST', $listen['host']);
define('SW_PORT', $listen['port']);

// 提示端口自动回退信息
announcePortFallbackIfNeeded($command, $listen);
// 处理生命周期命令
handleLifecycleCommand($command);

// 3. 创建swoole服务
try {
    $server = new Swoole\Http\Server(SW_HOST, SW_PORT);
} catch (Throwable $e) {
    swooleServiceLog('启动失败：无法创建监听，' . $e->getMessage());
    fwrite(STDERR, '启动失败：' . $e->getMessage() . "\n");
    exit(1); 
}

// 设置swoole服务配置
$server->set([
    // worker#0 发货队列/心跳/超时/热更新；worker#1 订单轮询；worker#2 商品同步（各进程独立定时器）
    'worker_num'      => 3,
    // 由 Supervisor/systemd 托管时应保持前台运行，避免双重守护
    'daemonize'       => false,
    // 主进程 PID 文件路径（stop/status/reload 命令依赖）
    'pid_file'        => SW_PID_FILE,
    // Swoole 运行日志文件
    'log_file'        => SW_LOG_FILE,
    // 仅记录 error 级别及以上日志，减少噪声
    'log_level'       => SWOOLE_LOG_ERROR,
    // 平滑重载：先拉起新 Worker，再等待旧 Worker 退出
    'reload_async'    => true,
    // 平滑重载最大等待秒数；超时后旧 Worker 会被强制回收
    'max_wait_time'   => 2, 
]);

// 4. 注册生命周期回调
/**
 * 生命周期：start
 * 触发时机：主进程启动完成并开始监听后。
 */
$server->on('start', function (Swoole\Http\Server $server) {
    // 升级包可在根目录放置空文件 `.server`，表示需硬重启；仅主进程 Start 时清理（reload 不会触发本回调）
    $dotServer = EM_ROOT . '/.server';
    if (is_file($dotServer)) {
        @unlink($dotServer);
        swooleServiceLog('已移除升级标记文件 .server');
    }
    $swoole_version = defined('SWOOLE_VERSION') ? SWOOLE_VERSION : (function_exists('swoole_version') ? swoole_version() : phpversion('swoole'));
    swooleServiceLog("启动：服务已开始监听 " . SW_HOST . ':' . SW_PORT . '，主进程 PID ' . $server->master_pid);
    echo "========================================\n";
    echo "EMSHOP Swoole 服务已启动！\n";
    echo "监听地址：" . SW_HOST . ':' . SW_PORT . "；主进程 PID {$server->master_pid}\n";
    echo "PHP cli版本：" . PHP_VERSION . '；Swoole扩展版本：' . $swoole_version . "\n";
    echo "========================================\n";
}); 

/**
 * 生命周期：workerStart
 * 触发时机：每个 Worker 进程启动时（共 3 次：#0 #1 #2）。
 */
$server->on('workerStart', function (Swoole\Http\Server $server, int $workerId) {
    require EM_ROOT . '/init.php';

    if ($workerId === 0) {
        registerWorkerZeroTimers($server, $workerId);
    } elseif ($workerId === 1) {
        registerWorkerOneTimers();
    } elseif ($workerId === 2) {
        registerWorkerTwoTimers();
    } 
});

/**
 * 生命周期：request
 * 触发时机：收到 HTTP 请求时（由 worker 处理）。
 */
$server->on('request', function (Swoole\Http\Request $request, Swoole\Http\Response $response) {
    $response->header('Content-Type', 'application/json; charset=utf-8');
    $response->status(404);
    $response->end(json_encode(['code' => 404, 'msg' => 'Not Found'], JSON_UNESCAPED_UNICODE));
});

/**
 * 生命周期：shutdown
 * 触发时机：Swoole 主进程退出时。
 */
$server->on('Shutdown', function () {
    swooleServiceLog('关闭：Swoole 主进程已退出');
});


// 5. 启动Swoole服务，主进程
try {
    $server->start(); // 开始触发workerStart
} catch (Throwable $e) {
    echo "EMSHOP Swoole 服务启动失败：" . $e->getMessage() . "\n";
    exit(1);
}


/**
 * 服务生命周期与异常日志（中文），追加写入 swoole.log。
 */
function swooleServiceLog(string $message): void
{
    $line = '[' . date('Y-m-d H:i:s') . '] ' . $message . "\n";
    @file_put_contents(SW_LOG_FILE, $line, FILE_APPEND | LOCK_EX);
}

/** PHP 7.x / Swoole 4 环境无 str_contains 时的兼容 */
function swooleStrContains(string $haystack, string $needle): bool
{
    if ($needle === '') {
        return true;
    }
    return strpos($haystack, $needle) !== false;
}

/** 当前 Swoole 扩展版本号，如 4.8.13 → 40813 */
function swooleExtVersionId(): int
{
    $raw = defined('SWOOLE_VERSION') ? (string) SWOOLE_VERSION : (string) (function_exists('swoole_version') ? swoole_version() : '0');
    if (!preg_match('/(\d+)\.(\d+)\.(\d+)/', $raw, $m)) {
        return 0;
    }
    return (int) $m[1] * 10000 + (int) $m[2] * 100 + (int) $m[3];
}

/**
 * 解析 Swoole 监听地址与端口。
 *
 * @param array<int, string> $argv
 * @return array{host: string, port: int, requested_port: int}
 */
function resolveSwooleListenAddress(array $argv): array
{ 
    $cli = parseCliListenOptions($argv);
    $host = $cli['host'] !== '' ? $cli['host'] : SW_DEFAULT_HOST;
    $requestedPort = $cli['port'];
    
    if ($requestedPort <= 0) {
        $requestedPort = SW_DEFAULT_PORT;
    }
    $port = pickAvailableListenPort($host, $requestedPort, 200);
    return ['host' => $host, 'port' => $port, 'requested_port' => $requestedPort];
}

/**
 * 解析命令行监听参数。
 *
 * @param array<int, string> $argv
 * @return array{host: string, port: int}
 */
function parseCliListenOptions(array $argv): array
{
    $host = '';
    $port = 0;

    foreach ($argv as $arg) {
        if (strpos($arg, '--host=') === 0) {
            $hostCandidate = trim(substr($arg, 7));
            if ($hostCandidate !== '' && preg_match('/^[a-zA-Z0-9\.\-\:\[\]_]+$/', $hostCandidate)) {
                $host = $hostCandidate;
            }
            continue;
        }

        if (strpos($arg, '--port=') === 0) {
            $portCandidate = (int) trim(substr($arg, 7));
            if ($portCandidate >= 1 && $portCandidate <= 65535) {
                $port = $portCandidate;
            }
        }
    }

    return ['host' => $host, 'port' => $port];
}

/**
 * 从期望端口开始，自动探测可监听的空闲端口。
 */
function pickAvailableListenPort(string $host, int $requestedPort, int $maxProbe = 200): int
{
    $requestedPort = max(1, min(65535, $requestedPort));
    if (canBindTcpPort($host, $requestedPort)) {
        return $requestedPort;
    }

    $endPort = min(65535, $requestedPort + max(1, $maxProbe));
    for ($port = $requestedPort + 1; $port <= $endPort; $port++) {
        if (canBindTcpPort($host, $port)) {
            return $port;
        }
    }

    // 兜底：回退原端口，让后续创建 Server 时按原有错误路径输出失败原因。
    return $requestedPort;
}

/**
 * 通过临时绑定测试端口是否可用。
 */
function canBindTcpPort(string $host, int $port): bool
{
    if ($port < 1 || $port > 65535) {
        return false;
    }
    $addr = 'tcp://' . $host . ':' . $port;
    $errno = 0;
    $errstr = '';
    $socket = @stream_socket_server($addr, $errno, $errstr, STREAM_SERVER_BIND | STREAM_SERVER_LISTEN);
    if ($socket === false) {
        return false;
    }
    @fclose($socket);
    return true;
}

/**
 * 准备启动环境（仅 start 命令会做锁与数据库探测）。
 *
 * @param array<int, string> $argv
 * @param resource|null $startLockFp
 * @return array{host: string, port: int, requested_port: int}
 */
function prepareStartEnvironment(string $command, array $argv, &$startLockFp): array
{
    if ($command !== 'start') {
        return ['host' => SW_DEFAULT_HOST, 'port' => SW_DEFAULT_PORT, 'requested_port' => SW_DEFAULT_PORT];
    }

    $startLockFp = acquireSwooleStartLock();
    $runningPid = getPid(SW_PID_FILE);
    if ($runningPid > 0 && posix_kill($runningPid, 0)) {
        echo "检测到EMSHOP Swoole 服务（PID {$runningPid}）已在运行中！\n";
        exit(0);
    }

    try {
        // 启动前仅做数据库探测，避免在 master 进程预先初始化框架并创建可被 fork 继承的连接。
        probeMysqlBeforeSwooleStart();
        swooleServiceLog("数据库连接成功，准备启动 Swoole");
    } catch (Throwable $e) {
        swooleServiceLog("启动失败：数据库未就绪，" . $e->getMessage());
        echo "数据库未就绪，退出进程，等待重试\n";
        sleep(6); // 守护进程有重试次数限制
        exit(1);
    }

    // 监听地址优先级：CLI 参数 > 数据库配置 > 默认值
    return resolveSwooleListenAddress($argv);
}

/**
 * 启动前提示端口自动回退信息（仅 start 命令）。
 *
 * @param array{host: string, port: int, requested_port: int} $listen
 */
function announcePortFallbackIfNeeded(string $command, array $listen): void
{
    if ($command !== 'start') {
        return;
    }

    $requestedPort = (int) ($listen['requested_port'] ?? SW_PORT);
    if ($requestedPort > 0 && $requestedPort !== SW_PORT) {
        echo "端口 {$requestedPort} 已被占用，自动切换到空闲端口 " . SW_PORT . "\n";
    }
}

/**
 * 处理生命周期命令（start/stop/status/reload）。
 */
function handleLifecycleCommand(string $command): void
{
    switch ($command) {
        case 'stop':
            $pid = getPid(SW_PID_FILE);
            if ($pid && posix_kill($pid, 0)) {
                posix_kill($pid, SIGTERM);
                swooleServiceLog("停止：已向主进程发送退出信号（PID {$pid}）");
                echo "已向主进程发送停止信号（PID {$pid}），服务即将退出。\n";
            } else {
                swooleServiceLog('停止：当前没有正在运行的 Swoole 主进程');
                echo "当前没有正在运行的 Swoole 服务。\n";
            }
            exit(0);

        case 'status':
            $pid = getPid(SW_PID_FILE);
            if ($pid && posix_kill($pid, 0)) {
                echo "Swoole 服务正在运行（主进程 PID：{$pid}）\n";
            } else {
                echo "Swoole 服务未在运行。\n";
            }
            exit(0);

        case 'reload':
            $pid = getPid(SW_PID_FILE);
            if ($pid && posix_kill($pid, 0)) {
                posix_kill($pid, SIGUSR1);
                swooleServiceLog("重载：已向主进程发送平滑重载信号（SIGUSR1，PID {$pid}）");
                echo "已发送平滑重载信号（PID {$pid}）。\n";
            } else {
                swooleServiceLog('重载失败：没有正在运行的主进程，无法重载');
                echo "服务未在运行，无法重载。\n";
                exit(1);
            }
            exit(0);

        case 'start':
            return;

        default:
            echo "用法：php server {start|stop|status|reload}\n";
            exit(1);
    }
}




/**
 * 读取 PID 文件，返回进程 ID。
 */
function getPid(string $pidFile): int
{
    if (!is_file($pidFile)) {
        return 0;
    }
    return (int) file_get_contents($pidFile);
}

/**
 * Swoole 启动前数据库探测：使用临时连接，成功后立即关闭，不污染运行时连接状态。
 */
function probeMysqlBeforeSwooleStart(): void
{
    $cfg = require EM_ROOT . '/config.php';
    $db = (array) ($cfg['db'] ?? []);

    $host = (string) ($db['host'] ?? '127.0.0.1');
    $port = (int) ($db['port'] ?? 3306);
    $dbname = (string) ($db['dbname'] ?? '');
    $username = (string) ($db['username'] ?? '');
    $password = (string) ($db['password'] ?? '');
    $charset = (string) ($db['charset'] ?? 'utf8mb4');

    if ($dbname === '' || $username === '') {
        throw new RuntimeException('数据库配置不完整');
    }

    if (extension_loaded('mysqli')) {
        mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);
        $mysqli = mysqli_init();
        $mysqli->real_connect($host, $username, $password, $dbname, $port);
        $mysqli->set_charset($charset);
        $rs = $mysqli->query('SELECT 1');
        if ($rs instanceof mysqli_result) {
            $rs->free();
        }
        $mysqli->close();
        return;
    }

    if (extension_loaded('pdo_mysql')) {
        $dsn = sprintf('mysql:host=%s;port=%d;dbname=%s;charset=%s', $host, $port, $dbname, $charset);
        $pdo = new PDO($dsn, $username, $password, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]);
        $pdo->query('SELECT 1');
        $pdo = null;
        return;
    }

    throw new RuntimeException('当前 PHP 环境既不支持 mysqli，也不支持 pdo_mysql，无法探测数据库连接');
}

/**
 * 获取 start 命令互斥锁，避免并发重复启动。
 *
 * @return resource
 */
function acquireSwooleStartLock()
{
    $fp = @fopen(SW_START_LOCK_FILE, 'c+');
    if ($fp === false) {
        echo "无法打开启动锁文件：" . SW_START_LOCK_FILE . "\n";
        exit(1);
    }

    if (!@flock($fp, LOCK_EX | LOCK_NB)) {
        echo "检测到另一个启动进程正在执行，已阻止重复启动。（如果刚刚关闭进程，请等待1~5分钟后再尝试启动）\n";
        exit(1);
    }

    @ftruncate($fp, 0);
    @fwrite($fp, (string) getmypid());
    @fflush($fp);
    return $fp;
}


/**
 * worker#0：发货队列、心跳、订单超时、代码热更新。
 */
function registerWorkerZeroTimers(Swoole\Http\Server $server, int $workerId): void
{
    @touch(SW_HEARTBEAT_FILE);

    Config::reload();
    $bootCodeVersion = (string) (Config::get('swoole_code_version') ?? '');

    /** 插件可在该钩子内注册自定义 timer 
    * 开发者注意此处不要注册易阻塞的定时器，否则会阻塞下面其他的定时器，导致无法执行发货等任务
    */
    try {
        doAction('swoole_worker_start', $server, $workerId);
    } catch (Throwable $e) {
    }

    // 每5秒刷新一次心跳文件
    Swoole\Timer::tick(5000, function () {
        @touch(SW_HEARTBEAT_FILE);
    });
    // 每2秒处理一次发货队列
    Swoole\Timer::tick(2000, function () {
        try {
            processQueue();
        } catch (Throwable $e) {
            swooleServiceLog('异常：发货队列 processQueue，' . $e->getMessage());
        }
    });
    // 每60秒检查一次待支付订单超时（轻量 SQL，直接在 worker#0 执行）
    Swoole\Timer::tick(60000, function () {
        try {
            runOrderTimeoutChecks();
        } catch (Throwable $e) {
            swooleServiceLog('异常：订单超时检查 runOrderTimeoutChecks，' . $e->getMessage());
        }
    });

    // 每60秒检查一次swoole代码版本
    Swoole\Timer::tick(60000, function () use ($server, $bootCodeVersion) {
        try {
            Config::reload();
            if (runSwooleFileVersionReloadCheck($server)) {
                return;
            }
            $current = (string) (Config::get('swoole_code_version') ?? '');
            if ($current !== '' && $current !== $bootCodeVersion) {
                echo "检测到代码版本变更（自 {$bootCodeVersion} 变更为 {$current}），正在触发热更新\n";
                if (!$server->reload()) {
                    echo "热更新失败（代码版本 {$bootCodeVersion} → {$current}）\n";
                    return;
                }
                echo "热更新成功（代码版本 {$bootCodeVersion} → {$current}）\n";
            }
        } catch (Throwable $e) {
            echo "代码热更新检查失败，" . $e->getMessage() . "\n";
        }
    });
}

/**
 * worker#1：订单轮询（插件钩子 swoole_order_poll_tick）。
 */
function registerWorkerOneTimers(): void
{
    $inFlight = false;

    Swoole\Timer::tick(60000, function () use (&$inFlight) {
        if ($inFlight) {
            return;
        }
        $inFlight = true;
        try {
            runOrderPollingTasks();
        } catch (Throwable $e) {
            swooleServiceLog('异常：订单轮询 runOrderPollingTasks，' . $e->getMessage());
        } finally {
            $inFlight = false;
        }
    });
}

/**
 * worker#2：商品同步（插件钩子 swoole_goods_sync_one；runGoodsSyncTasks 内另有运行锁）。
 */
function registerWorkerTwoTimers(): void
{
    Swoole\Timer::tick(60000, function () {
        try {
            runGoodsSyncTasks();
        } catch (Throwable $e) {
            swooleServiceLog('异常：商品同步 runGoodsSyncTasks，' . $e->getMessage());
        }
    });
}

/**
 * 队列消费：取任务、抢占、执行、更新状态。
 */
function processQueue(): void
{

    Config::reload();

    $prefix = Database::prefix();


    $task = Database::fetchOne(
        "SELECT * FROM {$prefix}delivery_queue
         WHERE status IN ('pending','retry') AND (next_retry_at IS NULL OR next_retry_at <= NOW())
         ORDER BY id ASC LIMIT 1"
    );

    if (!$task) {
        return;
    }

    $taskId = (int) $task['id'];

    swooleServiceLog('开始执行队列消费 >>> ' . $taskId);

    // 抢占任务（乐观锁）：将待处理任务原子地标记为「处理中」
    // - status='processing'：声明本 Worker 正在执行该任务，其他 Worker 不应再碰
    // - attempts=attempts+1：本次执行计入尝试次数，供后续失败重试 / 永久失败判断使用
    // - WHERE status IN ('pending','retry')：仅当任务仍为待处理/待重试时才更新；
    //   若另一 Worker 已抢先改走，本 UPDATE 影响行数为 0，下方直接 return 避免重复发货
    $affected = Database::execute(
        "UPDATE {$prefix}delivery_queue SET status='processing', attempts=attempts+1 WHERE id=? AND status IN ('pending','retry')",
        [$taskId]
    );
    if ($affected === 0) {
        // 抢占失败：任务已被其他进程认领，或状态已变更（success/failed/processing 等）
        swooleServiceLog('抢占任务失败 >>> ' . $taskId);
        return;
    }

    swooleServiceLog('抢占任务成功 >>> ' . $taskId);

    try {
        $orderId = (int) $task['order_id'];
        $orderGoodsId = (int) $task['order_goods_id'];
        $goodsType = $task['goods_type'];
        $payload = json_decode($task['payload'] ?? '{}', true) ?: [];

        swooleServiceLog('开始执行任务 >>> ' . $orderId . ' >>> ' . "goods_type_{$goodsType}_order_paid");

        doAction("goods_type_{$goodsType}_order_paid", $orderId, $orderGoodsId, json_encode($payload));

        swooleServiceLog('执行任务成功 >>> ' . $orderId . ' >>> ' . "goods_type_{$goodsType}_order_paid");

        Database::execute(
            "UPDATE {$prefix}delivery_queue SET status='success', completed_at=NOW() WHERE id=?",
            [$taskId]
        );
        swooleServiceLog('更新任务状态成功 >>> ' . $taskId);


        OrderModel::notifyDeliveryCallback($orderGoodsId);

        // 统一队列成功钩子：供通知类插件在"发货动作真正完成"后接入
        // 参数：
        // 1) order_id
        // 2) order_goods_id
        // 3) queue_task_id
        // 4) 原始队列任务行
        try {
            doAction('order_goods_delivery_queued_success', $orderId, $orderGoodsId, $taskId, $task);
        } catch (Throwable $hookErr) { }

        OrderModel::checkDeliveryComplete($orderId);

    } catch (Throwable $e) {
        $attempts = (int) $task['attempts'] + 1;
        $maxAttempts = (int) $task['max_attempts'];

        $isPermanent = $e instanceof PermanentDeliveryException;

        if ($isPermanent || $attempts >= $maxAttempts) {
            Database::execute(
                "UPDATE {$prefix}delivery_queue SET status='failed', last_error=? WHERE id=?",
                [($isPermanent ? '[永久失败] ' : '') . $e->getMessage(), $taskId]
            );
        } else {
            $delay = min(300, 30 * pow(2, $attempts - 1));
            Database::execute(
                "UPDATE {$prefix}delivery_queue SET status='retry', last_error=?, next_retry_at=DATE_ADD(NOW(), INTERVAL ? SECOND) WHERE id=?",
                [$e->getMessage(), $delay, $taskId]
            );
        }
    }
}

