function emshop_menu(): void
{
    emo_banner();
    emo_box([
        emo_bold(emo_cyan('[1]')) . '  ' . '查看管理员账号',
        emo_bold(emo_cyan('[2]')) . '  ' . '修改管理员密码',
        emo_bold(emo_gray('[h]')) . '  ' . emo_dim('查看帮助'),
        emo_bold(emo_gray('[0]')) . '  ' . emo_dim('退出'),
    ], 'round', EMO_GRAY, 1);
    emo_out();
}

function emshop_run_menu(EmshopCliDb $db, string $userTable): void
{
    while (true) {
        emshop_menu();
        $choice = strtolower(emshop_prompt('请选择操作'));

        if ($choice === '') {
            emo_out(emo_warn('请输入选项。'));
            continue;
        }
        if ($choice === '1' || $choice === 'list') {
            emshop_show_admins($db, $userTable);
            continue;
        }
        if ($choice === '2' || $choice === 'password') {
            emshop_change_admin_password($db, $userTable);
            continue;
        }
        if ($choice === 'h' || $choice === 'help') {
            emshop_help();
            continue;
        }
        if ($choice === '0' || $choice === 'q' || $choice === 'exit') {
            emo_out(emo_ok('已退出，再见，好兄弟！'));
            exit(0);
        }

        emo_out(emo_fail('无效选项：' . $choice . '，请重新选择。'));
    }
}

